# -----------------------------------------------------------------------
# Example values for a second local instance. Do not copy the port block
# below into docker/.env-local: env_file values reach the containers
# (DATABASE_PORT, REDIS_PORT, and SUPERSET_PORT change where Superset
# connects and binds) but not Compose port mapping or the project name.
# For a second instance of docker-compose.yml use `make up`, or export these
# in your shell (only docker-compose.yml maps these ports; the non-dev and
# image-tag stacks publish fixed ports, the light stack uses NODE_PORT only).
# Keep the same exports when you run the re-encrypt steps in the guide.
# Overwriting docker/.env-local also drops SUPERSET_SECRET_KEY.
# -----------------------------------------------------------------------

# SUPERSET_SECRET_KEY goes in docker/.env-local (gitignored), not in this file.
# Generate it with the snippet in the Docker Compose installation guide.

# Unique project name prevents container/volume conflicts between clones
# Each clone should have a different name (e.g., superset-pr123, superset-feature-x)
COMPOSE_PROJECT_NAME=superset-dev2

# Port offsets for running multiple instances simultaneously
# Instance 1 (default): 80, 8088, 9000, 8080, 8081, 5432, 6379
# Instance 2 example:   81, 8089, 9001, 8082, 8083, 5433, 6380
NGINX_PORT=81
SUPERSET_PORT=8089
NODE_PORT=9001
WEBSOCKET_PORT=8082
CYPRESS_PORT=8083
DATABASE_PORT=5433
REDIS_PORT=6380

# For verbose logging during development:
# SUPERSET_LOG_LEVEL=debug
